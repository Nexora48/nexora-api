    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nexora_db_pool_connections{state=\"busy\"}",
     "legendFormat": "busy",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "nexora_db_pool_connections{state=\"idle\"}",
     "legendFormat": "idle",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "nexora_db_pool_connections{state=\"max\"}",
     "legendFormat": "max",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Rate limited requests per second",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (limiter) (rate(nexora_rate_limited_total[5m]))",
     "legendFormat": "{{limiter}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Sign-ins per second",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (rate(nexora_logins_total[5m]))",
     "legendFormat": "{{result}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Go memory and goroutines",
   "gridPos": {
    "x": 0,
