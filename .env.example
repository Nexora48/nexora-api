# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=dev                       # dev | test | staging | prod  (anything but dev/test enforces the checks in config.Validate)
HTTP_ADDR=:8080
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora?sslmode=disable
REDIS_ADDR=localhost:6379
AUTO_MIGRATE=false                # true runs migrations at start-up (default true only in dev)

# ── Secrets (32+ characters, all different; never reuse between environments) ─
JWT_SECRET=change-me
PLATFORM_JWT_SECRET=
PLATFORM_ENC_KEY=                 # encrypts gateway keys and staff TOTP secrets; losing it loses them

# ── Web ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000   # comma-separated, explicit origins only (no *)
PUBLIC_BASE_URL=                     # https://api.example.com (hosted checkout links)
TRUST_PROXY=false                    # true only behind a reverse proxy that sets X-Forwarded-For
PLATFORM_ALLOWED_CIDRS=              # office/VPN ranges allowed to reach /superadmin (empty = anyone)

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_BODY_MB=16
SLOW_REQUEST_MS=1000
RATE_IP_PER_MIN=600                  # 0 switches the per-IP limit off (refused in prod)
RATE_USER_PER_MIN=900
DB_MAX_CONNS=25                      # pool size per API instance (times instances < Postgres max_connections)
SLOW_QUERY_MS=500                    # log statements slower than this (SQL text only); 0 = off
BACKUP_HEARTBEAT_FILE=               # file scripts/backup.sh touches; its age shows on the System page
CONSOLE_URL=                         # where the SuperAdmin web app lives (invitation e-mails)

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=                    # "fake" only for dev/test; societies bring their own Razorpay keys

# ── Observability ────────────────────────────────────────────────────────────
METRICS_TOKEN=                       # bearer token for /metrics (empty = loopback only)
SENTRY_DSN=                          # empty = off
DB_RLS=false                         # row-level security on tenant tables (see docs/runbooks/rls.md)

# ── Push, SMS, mail, files ───────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
BLOB_PATH=                           # photo/attachment store directory
SMTP_HOST=                           # empty = invitations are printed to the log in dev
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nexora <no-reply@example.com>
